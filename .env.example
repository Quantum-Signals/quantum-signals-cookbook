# ── QuantumSignals ──────────────────────────────────────────────────────────
QUANTUMSIGNALS_API_KEY=your_qs_api_key_here

# ── General ──────────────────────────────────────────────────────────────────
TRADER_DRY_RUN=true                    # true = simulated broker, no real orders (recommended first)
# SIM_PRICE_JITTER=0.001               # DRY_RUN price jitter (fraction of seed price); 0 = deterministic
TRADER_STRATEGY=momentum               # momentum | signal_follower
TRADER_ALLOWED_SYMBOLS=ES,NQ           # QS signal names: ES,NQ or S&P500,Nasdaq100; empty = allow all
TRADER_CLOSE_ON_EXIT=true
TRADER_DAILY_START_CAPITAL=100000      # momentum: order sizing; signal_follower: return % in summaries
TRADER_EXECUTION_INTERVAL_MINUTES=5

# ── Session (multi-day mode) ─────────────────────────────────────────────────
TRADER_SESSION_START_TIME=09:30
TRADER_SESSION_END_TIME=15:55
TRADER_SESSION_TIMEZONE=America/New_York
TRADER_RUN_DAYS=0                      # 0 = run indefinitely; N = exit after N EODs

# ── Broker ───────────────────────────────────────────────────────────────────
TRADER_BROKER=alpaca                   # selects an installed broker (ignored when TRADER_DRY_RUN=true)

# Alpaca credentials (only when TRADER_DRY_RUN=false and TRADER_BROKER=alpaca)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true               # true = paper account; false = live (real money)
# ALPACA_USE_MARKET_ORDERS=true # optional: false = limit orders
