# ── QuantumSignals ──────────────────────────────────────────────────────────
QUANTUMSIGNALS_API_KEY=your_qs_api_key_here

# ── General ──────────────────────────────────────────────────────────────────
# SIM_PRICE_JITTER=0.001               # simulated broker price jitter (fraction of seed price); 0 = deterministic
TRADER_STRATEGY=momentum
TRADER_ALLOWED_SYMBOLS=ES,NQ           # any alias works: ES/SPY/S&P500, NQ/QQQ/Nasdaq100; empty = all catalog
TRADER_CLOSE_ON_EXIT=true
# TRADER_CLOSE_ON_START=true            # close positions left by an earlier session before trading; default: same as CLOSE_ON_EXIT
# TRADER_FOLLOW_SIGNAL_WINDOWS=true     # trade inside each signal's published entry window, close at its exit time
# TRADER_US_MARKET_CALENDAR=true        # skip US holidays, end early on half days
TRADER_DAILY_START_CAPITAL=100000      # momentum: split across symbols for order sizing
# TRADER_SYMBOL_CAPITAL=ES:60000,NQ:40000  # optional: per-symbol capital (overrides equal split)
TRADER_EXECUTION_INTERVAL_MINUTES=5
TRADER_ACCOUNT_INFO_INTERVAL_MINUTES=0 # 0 = show after each trade; N = show every N minutes

# ── Session (multi-day mode) ─────────────────────────────────────────────────
TRADER_SESSION_START_TIME=09:30
TRADER_SESSION_END_TIME=15:55
TRADER_SESSION_TIMEZONE=America/New_York
TRADER_RUN_DAYS=0                      # 0 = run indefinitely; N = exit after N EODs

# ── Broker ───────────────────────────────────────────────────────────────────
TRADER_BROKER=simulated                # simulated = no real orders (recommended first); or alpaca, etc.

# Alpaca credentials (only when TRADER_BROKER=alpaca)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true               # true = paper account; false = live (real money)
# ALPACA_USE_MARKET_ORDERS=true # optional: false = limit orders

# Ironbeam REST API v3 (only when TRADER_BROKER=ironbeam). CME Group futures.
# Live and simulated are separate deployments: the key only works on the host
# for its environment, so set IRONBEAM_BASE_URL to the host from onboarding.
# USERNAME (trader id) and PASSWORD are needed for tenant keys; standard keys
# ignore the password.
# IRONBEAM_API_KEY=
# IRONBEAM_USERNAME=
# IRONBEAM_PASSWORD=
# IRONBEAM_ACCOUNT_ID=              # required only if the login sees several accounts
# IRONBEAM_BASE_URL=https://api.ironbeamapi.com
# IRONBEAM_USE_MICROS=true          # MES/MNQ/MYM/M2K/MCL/MGC/SIL instead of ES/NQ/YM/RTY/CL/GC/SI
# IRONBEAM_ROLL_DAYS=5              # skip contracts this close to expiry
# IRONBEAM_FILL_TIMEOUT_S=10
# IRONBEAM_DIAGNOSTICS=true         # log margin, account and order book checks around orders
