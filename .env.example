# ── QuantumSignals ──────────────────────────────────────────────────────────
QUANTUMSIGNALS_API_KEY=your_qs_api_key_here

# ── General ──────────────────────────────────────────────────────────────────
DRY_RUN=true                    # true = simulated broker, no real orders (recommended first)
STRATEGY=momentum               # momentum | signal_follower
ALLOWED_SYMBOLS=ES,NQ           # QS signal names: ES,NQ or S&P500,Nasdaq100; empty = allow all
CLOSE_ON_EXIT=true
DAILY_START_CAPITAL=100000      # momentum: order sizing; signal_follower: return % in summaries
EXECUTION_INTERVAL_MINUTES=5

# ── Session (multi-day mode) ─────────────────────────────────────────────────
SESSION_START_TIME=09:30
SESSION_END_TIME=15:55
SESSION_TIMEZONE=America/New_York
RUN_DAYS=0                      # 0 = run indefinitely; N = exit after N EODs

# ── Broker ───────────────────────────────────────────────────────────────────
BROKER=alpaca                   # alpaca | ibkr  (ignored when DRY_RUN=true)

# IBKR / IB Gateway settings (only when DRY_RUN=false and BROKER=ibkr)
# On Mac/Windows Docker: host.docker.internal reaches the host automatically.
# On Linux: set IB_HOST to your machine's LAN IP, or use network_mode: host.
IB_HOST=127.0.0.1
IB_PORT=4002                    # 4002 = paper gateway; 4001 = live
IB_CLIENT_ID=1
IB_MARKET_DATA_TYPE=4           # 1=live  3=delayed  4=delayed-frozen
# IB_USE_MARKET_ORDERS=true     # optional: false = limit orders

# Alpaca credentials (only when DRY_RUN=false and BROKER=alpaca)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true               # true = paper account; false = live (real money)
# ALPACA_USE_MARKET_ORDERS=true # optional: false = limit orders
