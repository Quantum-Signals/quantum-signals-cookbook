# ── QuantumSignals ──────────────────────────────────────────────────────────
QUANTUMSIGNALS_API_KEY=your_qs_api_key_here

# ── General ──────────────────────────────────────────────────────────────────
# SIM_PRICE_JITTER=0.001               # simulated broker price jitter (fraction of seed price); 0 = deterministic
TRADER_STRATEGY=momentum
TRADER_ALLOWED_SYMBOLS=ES,NQ           # any alias works: ES/SPY/S&P500, NQ/QQQ/Nasdaq100; empty = all catalog
TRADER_CLOSE_ON_EXIT=true
TRADER_DAILY_START_CAPITAL=100000      # momentum: split across symbols for order sizing
# TRADER_SYMBOL_CAPITAL=ES:60000,NQ:40000  # optional: per-symbol capital (overrides equal split)
TRADER_EXECUTION_INTERVAL_MINUTES=5
TRADER_ACCOUNT_INFO_INTERVAL_MINUTES=0 # 0 = show after each trade; N = show every N minutes

# ── Session (multi-day mode) ─────────────────────────────────────────────────
TRADER_SESSION_START_TIME=09:30
TRADER_SESSION_END_TIME=15:55
TRADER_SESSION_TIMEZONE=America/New_York
TRADER_RUN_DAYS=0                      # 0 = run indefinitely; N = exit after N EODs

# ── Broker ───────────────────────────────────────────────────────────────────
TRADER_BROKER=simulated                # simulated = no real orders (recommended first); or alpaca, etc.

# Alpaca credentials (only when TRADER_BROKER=alpaca)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true               # true = paper account; false = live (real money)
# ALPACA_USE_MARKET_ORDERS=true # optional: false = limit orders

# TMGM via the local MetaTrader 5 terminal (only when TRADER_BROKER=tmgm).
# Windows uses the official MetaTrader5 package. macOS uses MetaTrader 5.app
# (https://www.metatrader5.com/en/download) and the mt5-mac Wine bridge.
# Log into the MT5 demo (not TradeMaxGlobal-Live2) and turn Algo Trading on.
# Empty login attaches to the terminal session already open.
# TMGM_ALLOW_LIVE defaults off and refuses a real-money account.
# TMGM_LOGIN=
# TMGM_PASSWORD=
# TMGM_SERVER=TradeMaxGlobal-Demo
# TMGM_TERMINAL_PATH=
# TMGM_ALLOW_LIVE=false
# TMGM_DEVIATION=100
