# ── QuantumSignals ──────────────────────────────────────────────────────────
QUANTUMSIGNALS_API_KEY=your_qs_api_key_here

# ── General ──────────────────────────────────────────────────────────────────
DRY_RUN=true                    # true = simulated gateway, no real orders
STRATEGY=momentum               # momentum | signal_follower
ALLOWED_SYMBOLS=ES,NQ           # comma-separated; empty = allow all
CLOSE_ON_EXIT=true
DAILY_START_CAPITAL=100000
EXECUTION_INTERVAL_MINUTES=5

# ── Broker ───────────────────────────────────────────────────────────────────
BROKER=alpaca                   # alpaca | ibkr  (code default: alpaca; ignored when DRY_RUN=true)

# IBKR / IB Gateway settings
# On Mac/Windows Docker: host.docker.internal reaches the host automatically.
# On Linux: set IB_HOST to your machine's LAN IP, or use network_mode: host.
IB_HOST=host.docker.internal
IB_PORT=4002
IB_CLIENT_ID=1
IB_MARKET_DATA_TYPE=4           # 1=live  3=delayed  4=delayed-frozen

# Alpaca credentials (only needed when BROKER=alpaca)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
